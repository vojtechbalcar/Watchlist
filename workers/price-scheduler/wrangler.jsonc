{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gowatchlist-price-scheduler",
  "main": "index.mjs",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["2-59/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
