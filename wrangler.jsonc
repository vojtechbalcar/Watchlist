{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gowatchlist",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // No Cron Trigger: on the Free plan scheduled runs are killed at 10 ms of CPU.
  // workers/price-scheduler calls the authenticated price route instead. An empty
  // list removes the trigger from the deployed Worker.
  "triggers": {
    "crons": []
  },
  // `pnpm run build` produces .open-next; `wrangler deploy` hands off to `opennextjs-cloudflare deploy`.
  "observability": {
    "enabled": true
  }
}
