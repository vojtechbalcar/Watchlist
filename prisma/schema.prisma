// Price data lives here and nowhere else. Only the cron job in
// src/app/api/cron/prices writes it, and only it calls the stock API.

// The classic generator, with its default output in node_modules: its package
// has a `workerd` entry that loads the query compiler as a real .wasm module,
// which Cloudflare Workers require. The newer `prisma-client` generator only
// offers that through a `.wasm?module` import Next.js can't compile.
generator client {
  provider = "prisma-client-js"
}

// Prisma 7 keeps connection URLs out of the schema; see prisma.config.ts.
datasource db {
  provider = "postgresql"
}

/// A stock is measured against a benchmark, and a benchmark is an instrument
/// the same tables describe, so both live in one table rather than two.
enum InstrumentKind {
  STOCK
  BENCHMARK
}

model Instrument {
  ticker          String         @id
  name            String
  kind            InstrumentKind @default(STOCK)
  /// Null for benchmarks, which belong to no sector.
  sector          String?
  currency        String         @default("USD")
  logoSrc         String?
  /// The index or ETF this instrument's return is compared with.
  benchmarkTicker String?
  benchmark       Instrument?    @relation("MeasuredAgainst", fields: [benchmarkTicker], references: [ticker], onDelete: SetNull)
  measured        Instrument[]   @relation("MeasuredAgainst")
  closes          DailyClose[]
  quote           Quote?
  /// When the price job last asked for this instrument's daily closes, so a
  /// market holiday doesn't make it ask again on every run.
  closesCheckedAt DateTime?

  @@index([kind, sector])
}

/// One row per instrument per trading day. Every range the app offers is a
/// lookup of two of these.
model DailyClose {
  ticker     String
  date       DateTime   @db.Date
  close      Decimal    @db.Decimal(14, 4)
  instrument Instrument @relation(fields: [ticker], references: [ticker], onDelete: Cascade)

  @@id([ticker, date])
  @@index([ticker, date(sort: Desc)])
}

/// The latest price and day move, replaced on each run of the price job.
model Quote {
  ticker     String     @id
  price      Decimal    @db.Decimal(14, 4)
  changeAbs  Decimal    @db.Decimal(14, 4)
  changePct  Decimal    @db.Decimal(9, 4)
  /// The market time the price is from.
  asOf       DateTime
  /// When the job fetched it, which decides when it is due again.
  fetchedAt  DateTime   @default(now())
  instrument Instrument @relation(fields: [ticker], references: [ticker], onDelete: Cascade)
}

/// Every stock search can find: Twelve Data's NASDAQ and NYSE listings, synced
/// daily. Tracked instruments appear here too. Their prices come from Quote;
/// the price columns here cache what search fetched for everything else.
model Listing {
  symbol          String    @id
  name            String
  exchange        String
  type            String
  currency        String    @default("USD")
  /// Null until search first asks for it; see logoCheckedAt.
  logoUrl         String?
  /// Set once the logo was requested, even when Twelve Data had none.
  logoCheckedAt   DateTime?
  price           Decimal?  @db.Decimal(14, 4)
  changeAbs       Decimal?  @db.Decimal(14, 4)
  changePct       Decimal?  @db.Decimal(9, 4)
  priceFetchedAt  DateTime?
  /// About a year of daily closes as [["YYYY-MM-DD", close], …], oldest first,
  /// fetched when someone opens the stock's page. Tracked instruments use
  /// DailyClose instead.
  closes          Json?
  closesFetchedAt DateTime?
  /// The SEC's company number, matched by ticker; null when EDGAR doesn't list it.
  cik             Int?
  /// The SEC industry code and the app sector it maps to; see src/lib/sec-sectors.ts.
  sic             Int?
  sector          String?
  /// Set once EDGAR was asked, so companies without a code aren't asked again.
  sectorCheckedAt DateTime?

  @@index([sector])
  @@index([cik])
}

/// Twelve Data credits spent, per UTC minute ("m:2026-10-01T14:05") and per
/// UTC day ("d:2026-10-01"). Every caller reserves here before calling.
model ApiUsage {
  bucket  String @id
  credits Int    @default(0)
}

/// When a recurring job last completed, for jobs that run less often than the
/// schedule fires.
model JobState {
  job   String   @id
  ranAt DateTime
}

/// An account. Auth.js signs people in with email and password and keeps the
/// session in a signed cookie, so this is the only auth table.
model User {
  id           String   @id @default(cuid())
  /// Stored lowercased, so sign-in is case-insensitive.
  email        String   @unique
  name         String?
  /// scrypt, as `salt:hash` in hex.
  passwordHash String
  createdAt    DateTime @default(now())
}

/// A response built ahead of time because assembling it per request is slow,
/// e.g. the ~6,400-row stock directory. Rebuilt by the price job when its
/// inputs change.
model Snapshot {
  key     String   @id
  body    String
  builtAt DateTime
}
